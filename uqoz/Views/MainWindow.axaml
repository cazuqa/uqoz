<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:uqoz.ViewModels"
        x:Class="uqoz.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="uqoz"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

	<Grid>

		<!-- ================= ЭКРАН ВХОДА ================= -->
		<Grid IsVisible="{Binding !IsLoggedIn}" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Border Background="{DynamicResource Surface}"
			        BorderBrush="{DynamicResource Border}" BorderThickness="1"
			        CornerRadius="20" Padding="34" Width="420">
				<StackPanel Spacing="14">
					<TextBlock Text="uqoz" FontSize="34" FontWeight="Bold"
					           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
					<TextBlock Text="Мессенджер с шифрованием" FontSize="12"
					           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"
					           Margin="0,0,0,8"/>

					<TextBox PlaceholderText="Ник (нужен только для регистрации)"
					         Text="{Binding AuthNick, Mode=TwoWay}"/>
					<TextBox PlaceholderText="Почта" Text="{Binding AuthEmail, Mode=TwoWay}"/>
					<TextBox PlaceholderText="Пароль" PasswordChar="•"
					         Text="{Binding AuthPassword, Mode=TwoWay}"/>

					<Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
						<Button Grid.Column="0" Content="Войти" Classes="primary"
						        Command="{Binding LoginCommand}" Margin="0,0,4,0"/>
						<Button Grid.Column="1" Content="Регистрация"
						        Command="{Binding RegisterCommand}" Margin="4,0,0,0"/>
					</Grid>

					<TextBlock Text="Подключаемся…" IsVisible="{Binding IsBusy}"
					           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
					<TextBlock Text="{Binding AuthErrorText}" Foreground="{DynamicResource Danger}"
					           TextWrapping="Wrap" HorizontalAlignment="Center"/>

					<Border Height="1" Background="{DynamicResource Border}" Margin="0,6"/>

					<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
						<TextBlock Text="Тема:" VerticalAlignment="Center" FontSize="12"
						           Foreground="{DynamicResource TextMuted}"/>
						<Button Content="Тёмная" Classes="pill" Classes.active="{Binding IsDarkTheme}"
						        Command="{Binding SetThemeCommand}" CommandParameter="dark" FontSize="12"/>
						<Button Content="Светлая" Classes="pill" Classes.active="{Binding IsLightTheme}"
						        Command="{Binding SetThemeCommand}" CommandParameter="light" FontSize="12"/>
						<Button Content="Система" Classes="pill" Classes.active="{Binding IsSystemTheme}"
						        Command="{Binding SetThemeCommand}" CommandParameter="system" FontSize="12"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

		<!-- ================= ОСНОВНОЙ ЭКРАН ================= -->
		<Grid IsVisible="{Binding IsLoggedIn}" ColumnDefinitions="240,*,240">

			<!-- Левая панель: поиск, друзья, чаты -->
			<Border Grid.Column="0" Background="{DynamicResource Surface}"
			        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
				<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10,10,10,10">

					<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
						<TextBox Grid.Column="0" PlaceholderText="Поиск чатов"
						         Text="{Binding SearchText, Mode=TwoWay}"/>
						<Button Grid.Column="1" Classes="ghost" Width="32" Height="32" Margin="6,0,0,0"
						        ToolTip.Tip="Обновить" Command="{Binding RefreshCommand}">
							<PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
							          Width="15" Height="15"/>
						</Button>
					</Grid>

					<Button Grid.Row="1" Content="Друзья" Classes="pill" Margin="0,0,0,10"
					        HorizontalAlignment="Stretch"
					        Classes.active="{Binding IsFriendsMode}"
					        Command="{Binding ShowFriendsCommand}"/>

					<Grid Grid.Row="2">

						<!-- ЛИЧНЫЕ СООБЩЕНИЯ -->
						<DockPanel IsVisible="{Binding IsChatsMode}">
							<TextBlock DockPanel.Dock="Top" Text="ЛИЧНЫЕ СООБЩЕНИЯ" FontSize="11" FontWeight="Bold"
							           Foreground="{DynamicResource TextMuted}" Margin="6,0,6,6"/>
							<ListBox ItemsSource="{Binding VisibleContacts}"
							         SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="36,*">
											<Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
											        Background="{DynamicResource SurfaceAlt}">
												<TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold"
												           HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>
											<TextBlock Grid.Column="1" Text="{Binding Nick}" FontSize="14"
											           Margin="10,0,0,0" VerticalAlignment="Center"
											           TextTrimming="CharacterEllipsis"/>
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</DockPanel>

						<!-- ДРУЗЬЯ (заготовка) -->
						<StackPanel IsVisible="{Binding IsFriendsMode}" Spacing="8">
							<TextBlock Text="ДРУЗЬЯ" FontSize="11" FontWeight="Bold"
							           Foreground="{DynamicResource TextMuted}" Margin="6,0"/>
							<Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="12">
								<StackPanel Spacing="4">
									<TextBlock Text="Пока пусто" FontWeight="SemiBold" FontSize="13"/>
									<TextBlock Text="Заявки в друзья ещё не сделаны. Чтобы написать человеку — открой «Личные сообщения»."
									           FontSize="11" Foreground="{DynamicResource TextMuted}"
									           TextWrapping="Wrap"/>
								</StackPanel>
							</Border>
						</StackPanel>

						<!-- КАНАЛЫ (выключены) -->
						<StackPanel IsVisible="{Binding IsChannelsMode}" Spacing="8">
							<TextBlock Text="КАНАЛЫ" FontSize="11" FontWeight="Bold"
							           Foreground="{DynamicResource TextMuted}" Margin="6,0"/>
							<Border Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="12">
								<StackPanel Spacing="4">
									<TextBlock Text="Выключено" FontWeight="SemiBold" FontSize="13"/>
									<TextBlock Text="Каналы будут как в Discord, но концепция ещё не додумана — вкладка пока пустая."
									           FontSize="11" Foreground="{DynamicResource TextMuted}"
									           TextWrapping="Wrap"/>
								</StackPanel>
							</Border>
						</StackPanel>
					</Grid>

					<!-- Нижняя панель: каналы, стрелка (аккаунт и настройки), ЛС -->
					<Border Grid.Row="3" Background="{DynamicResource SurfaceAlt}"
					        CornerRadius="16" Margin="0,10,0,0" Padding="4">
						<Grid>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4"
							            IsVisible="{Binding IsTabMode}">
								<Button Width="44" Height="30" Classes="pill"
								        Classes.active="{Binding IsChannelsMode}"
								        ToolTip.Tip="Каналы (выключены)"
								        Command="{Binding ShowChannelsCommand}">
									<PathIcon Data="M16,13C15.71,13 15.38,13.03 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5C15.71,5 15.38,5.03 15.03,5.05C15.62,5.87 16,6.9 16,8A4,4 0 0,1 16,11Z"
									          Width="16" Height="16"/>
								</Button>
								<Button Classes="ghost" Width="44" Height="30" ToolTip.Tip="Аккаунт и настройки"
								        Command="{Binding ToggleBottomPanelCommand}">
									<PathIcon Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z"
									          Width="16" Height="16"/>
								</Button>
								<Button Width="44" Height="30" Classes="pill" Classes.active="{Binding IsChatsMode}"
								        ToolTip.Tip="Личные сообщения" Command="{Binding ShowChatsCommand}">
									<PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4C22,2.89 21.1,2 20,2Z"
									          Width="16" Height="16"/>
								</Button>
							</StackPanel>
							<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4"
							            IsVisible="{Binding !IsTabMode}">
								<Button Classes="ghost" Width="36" Height="30" ToolTip.Tip="Назад к чатам"
								        Command="{Binding ToggleBottomPanelCommand}">
									<PathIcon Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"
									          Width="16" Height="16"/>
								</Button>
								<Button Content="Аккаунт" Classes="pill" Classes.active="{Binding IsAccountView}"
								        Command="{Binding ShowAccountCommand}" FontSize="12"/>
								<Button Content="Настройки" Classes="pill" Classes.active="{Binding IsSettingsView}"
								        Command="{Binding ShowSettingsCommand}" FontSize="12"/>
							</StackPanel>
						</Grid>
					</Border>
				</Grid>
			</Border>

			<!-- Центр: переписка -->
			<Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

				<Border Grid.Row="0" Background="{DynamicResource Surface}"
				        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,10">
					<Grid ColumnDefinitions="*,Auto">
						<StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
							<TextBlock Text="{Binding ActiveChatTitle}" FontSize="15" FontWeight="Bold"/>
							<TextBlock Text="{Binding ActiveChatSubtitle}" FontSize="11"
							           Foreground="{DynamicResource TextMuted}"/>
							<TextBlock Text="{Binding LastError}" FontSize="11"
							           Foreground="{DynamicResource Danger}" TextWrapping="Wrap"/>
						</StackPanel>
						<Button Grid.Column="1" Classes="ghost" Width="36" Height="32" VerticalAlignment="Center"
						        ToolTip.Tip="Позвонить" Command="{Binding StartCallCommand}">
							<PathIcon Data="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
							          Width="16" Height="16"/>
						</Button>
					</Grid>
				</Border>

				<Grid Grid.Row="1">
					<ScrollViewer Padding="18,12" VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding Messages}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Grid Margin="0,3">
										<Border IsVisible="{Binding IsMine}" HorizontalAlignment="Right"
										        MaxWidth="460" Background="{DynamicResource Accent}"
										        CornerRadius="14,14,4,14" Padding="11,8">
											<StackPanel>
												<TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FFFFFF"/>
												<TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="#CCFFFFFF"
												           HorizontalAlignment="Right" Margin="0,2,0,0"/>
											</StackPanel>
										</Border>
										<Border IsVisible="{Binding !IsMine}" HorizontalAlignment="Left"
										        MaxWidth="460" Background="{DynamicResource BubbleOther}"
										        CornerRadius="14,14,14,4" Padding="11,8">
											<StackPanel>
												<TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="SemiBold"
												           Foreground="{DynamicResource Accent}"/>
												<TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
												<TextBlock Text="{Binding TimeText}" FontSize="10"
												           Foreground="{DynamicResource TextMuted}"
												           HorizontalAlignment="Right" Margin="0,2,0,0"/>
											</StackPanel>
										</Border>
									</Grid>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>

					<StackPanel IsVisible="{Binding !HasContact}" HorizontalAlignment="Center"
					            VerticalAlignment="Center" Spacing="6">
						<TextBlock Text="Тишина" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
						<TextBlock Text="Выберите собеседника в списке слева"
						           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
					</StackPanel>

					<StackPanel IsVisible="{Binding ShowEmptyChatHint}" HorizontalAlignment="Center"
					            VerticalAlignment="Center" Spacing="6">
						<TextBlock Text="Пока ни слова" FontSize="18" FontWeight="SemiBold"
						           HorizontalAlignment="Center"/>
						<TextBlock Text="Напишите первым — сообщение зашифруется и уйдёт сразу"
						           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"
						           TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center"/>
					</StackPanel>
				</Grid>

				<!-- Поле ввода -->
				<Border Grid.Row="2" Background="{DynamicResource Surface}"
				        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="14,10">
					<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">

						<Button Grid.Column="0" Classes="ghost" Width="32" Height="32" IsEnabled="False"
						        ToolTip.Tip="Вложения скоро">
							<PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="16" Height="16"/>
						</Button>

						<TextBox Grid.Column="1" Margin="6,0" Text="{Binding NewMessageText, Mode=TwoWay}"
						         PlaceholderText="Сообщение…" IsEnabled="{Binding HasContact}"/>

						<Button Grid.Column="2" Classes="ghost" Width="32" Height="32" IsEnabled="False"
						        ToolTip.Tip="GIF скоро">
							<TextBlock Text="GIF" FontSize="10" FontWeight="Bold"/>
						</Button>

						<Button Grid.Column="3" Classes="ghost" Width="32" Height="32" ToolTip.Tip="Эмодзи">
							<PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M7,9.5A1.5,1.5 0 0,1 8.5,8A1.5,1.5 0 0,1 10,9.5A1.5,1.5 0 0,1 8.5,11A1.5,1.5 0 0,1 7,9.5M14,9.5A1.5,1.5 0 0,1 15.5,8A1.5,1.5 0 0,1 17,9.5A1.5,1.5 0 0,1 15.5,11A1.5,1.5 0 0,1 14,9.5M12,17.5C9.67,17.5 7.69,16.04 6.89,14H17.11C16.31,16.04 14.33,17.5 12,17.5Z"
							          Width="16" Height="16"/>
							<Button.Flyout>
								<Flyout Placement="Top">
									<WrapPanel Width="200">
										<Button Content="😀" Command="{Binding InsertEmojiCommand}" CommandParameter="😀" Classes="ghost" Width="32" Height="32"/>
										<Button Content="😄" Command="{Binding InsertEmojiCommand}" CommandParameter="😄" Classes="ghost" Width="32" Height="32"/>
										<Button Content="😉" Command="{Binding InsertEmojiCommand}" CommandParameter="😉" Classes="ghost" Width="32" Height="32"/>
										<Button Content="😍" Command="{Binding InsertEmojiCommand}" CommandParameter="😍" Classes="ghost" Width="32" Height="32"/>
										<Button Content="🤔" Command="{Binding InsertEmojiCommand}" CommandParameter="🤔" Classes="ghost" Width="32" Height="32"/>
										<Button Content="😢" Command="{Binding InsertEmojiCommand}" CommandParameter="😢" Classes="ghost" Width="32" Height="32"/>
										<Button Content="😡" Command="{Binding InsertEmojiCommand}" CommandParameter="😡" Classes="ghost" Width="32" Height="32"/>
										<Button Content="🔥" Command="{Binding InsertEmojiCommand}" CommandParameter="🔥" Classes="ghost" Width="32" Height="32"/>
										<Button Content="👍" Command="{Binding InsertEmojiCommand}" CommandParameter="👍" Classes="ghost" Width="32" Height="32"/>
										<Button Content="❤️" Command="{Binding InsertEmojiCommand}" CommandParameter="❤️" Classes="ghost" Width="32" Height="32"/>
										<Button Content="🎉" Command="{Binding InsertEmojiCommand}" CommandParameter="🎉" Classes="ghost" Width="32" Height="32"/>
										<Button Content="😴" Command="{Binding InsertEmojiCommand}" CommandParameter="😴" Classes="ghost" Width="32" Height="32"/>
									</WrapPanel>
								</Flyout>
							</Button.Flyout>
						</Button>

						<Button Grid.Column="4" Classes="primary" Width="40" Height="40" CornerRadius="20"
						        Margin="8,0,0,0"
						        Command="{Binding SendMessageCommand}" ToolTip.Tip="Отправить">
							<PathIcon Data="M2,21L23,12L2,3V10L17,12L2,14V21Z" Width="15" Height="15"
							          Foreground="{DynamicResource OnAccent}"/>
						</Button>
					</Grid>
				</Border>
			</Grid>

			<!-- Правая панель: участники -->
			<Border Grid.Column="2" Background="{DynamicResource Surface}"
			        BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
				<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10,10,10,10">

					<TextBox Grid.Row="0" PlaceholderText="Поиск"
					         Text="{Binding ParticipantSearchText, Mode=TwoWay}" Margin="0,0,0,10"/>

					<TextBlock Grid.Row="1" Text="{Binding ParticipantsTitle}" FontSize="11" FontWeight="Bold"
					           Foreground="{DynamicResource TextMuted}" Margin="6,0,0,6"/>

					<ListBox Grid.Row="2" ItemsSource="{Binding VisibleParticipants}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="34,*">
									<Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
									        Background="{DynamicResource SurfaceAlt}">
										<TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
										           HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
									<TextBlock Grid.Column="1" Text="{Binding Nick}" FontSize="13"
									           Margin="9,0,0,0" VerticalAlignment="Center"
									           TextTrimming="CharacterEllipsis"/>
								</Grid>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>

					<StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
						<Border IsVisible="{Binding HasIncomingCall}"
						        Background="{DynamicResource SurfaceAlt}" CornerRadius="12" Padding="10">
							<StackPanel Spacing="8">
								<TextBlock Text="Входящий звонок" FontWeight="SemiBold" FontSize="12"
								           HorizontalAlignment="Center"/>
								<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
									<Button Content="Принять" Classes="primary" FontSize="12"
									        Command="{Binding AcceptCallCommand}"/>
									<Button Content="Отклонить" Classes="danger" FontSize="12"
									        Command="{Binding RejectCallCommand}"/>
								</StackPanel>
							</StackPanel>
						</Border>

						<TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMuted}"
						           HorizontalAlignment="Center" FontSize="11"/>
						<Button Content="Позвонить" Classes="primary" Command="{Binding StartCallCommand}"
						        HorizontalAlignment="Stretch" FontSize="12"/>
						<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
							<Button Command="{Binding ToggleMuteCommand}" ToolTip.Tip="Микрофон" Width="40" Height="32">
								<PathIcon Data="M12,2A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 12,2Z"
								          Width="14" Height="14"/>
							</Button>
							<Button Command="{Binding ToggleScreenShareCommand}" ToolTip.Tip="Экран" Width="40" Height="32">
								<PathIcon Data="M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z"
								          Width="14" Height="14"/>
							</Button>
							<Button Classes="danger" Command="{Binding EndCallCommand}" ToolTip.Tip="Завершить"
							        Width="40" Height="32">
								<PathIcon Data="M12,9C10.4,9 8.85,9.25 7.4,9.72V12.82C7.4,13.22 7.17,13.56 6.84,13.72C5.86,14.21 4.96,14.82 4.16,15.5C3.96,15.7 3.7,15.8 3.42,15.8C3.14,15.8 2.88,15.7 2.68,15.5L0.88,13.7C0.68,13.5 0.58,13.24 0.58,12.96C0.58,12.68 0.68,12.42 0.88,12.22C3.88,9.36 7.8,7.5 12,7.5C16.2,7.5 20.12,9.36 23.12,12.22C23.32,12.42 23.42,12.68 23.42,12.96C23.42,13.24 23.32,13.5 23.12,13.7L21.32,15.5C21.12,15.7 20.86,15.8 20.58,15.8C20.3,15.8 20.04,15.7 19.84,15.5C19.04,14.82 18.14,14.21 17.16,13.72C16.83,13.56 16.6,13.22 16.6,12.82V9.72C15.15,9.25 13.6,9 12,9Z"
								          Width="14" Height="14"/>
							</Button>
						</StackPanel>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>
